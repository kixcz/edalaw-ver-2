# dssclearn/.htaccess (project root -> send traffic into /public)
Options -Indexes -MultiViews +SymLinksIfOwnerMatch
DirectoryIndex public/index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let’s Encrypt challenges (avoid 403 on dotfiles)
  RewriteRule ^\.well-known/ - [L]
RewriteRule ^storage/(.*)$ /uploads/$1 [L,R=301]
  # Serve existing files/dirs normally
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise, send everything to /public/index.php
  RewriteRule ^ public/index.php [L]
</IfModule>

# Block hidden dotfiles EXCEPT the .well-known we allowed above
<IfModule mod_authz_core.c>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
</IfModule>
